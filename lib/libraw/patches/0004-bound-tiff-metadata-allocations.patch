--- a/libraw/libraw_const.h
+++ b/libraw/libraw_const.h
@@ -28,6 +28,12 @@
 #define LIBRAW_MAX_PROFILE_SIZE_MB 256LL
 #endif
 
+/* Cumulative member-allocator budget while open_datastream() is identifying
+ * metadata. Zero preserves upstream's unbounded behavior. */
+#ifndef LIBRAW_MAX_METADATA_ALLOC_SIZE_MB
+#define LIBRAW_MAX_METADATA_ALLOC_SIZE_MB 0LL
+#endif
+
 #ifndef LIBRAW_MAX_NONDNG_RAW_FILE_SIZE
 #define LIBRAW_MAX_NONDNG_RAW_FILE_SIZE 2147483647LL
 #endif
