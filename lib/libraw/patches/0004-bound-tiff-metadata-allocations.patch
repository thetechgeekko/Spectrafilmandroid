diff --git a/src/utils/utils_libraw.cpp b/src/utils/utils_libraw.cpp
--- a/src/utils/utils_libraw.cpp
+++ b/src/utils/utils_libraw.cpp
@@ -257,6 +257,19 @@
 
 void *LibRaw::malloc(size_t t)
 {
+#if LIBRAW_MAX_METADATA_ALLOC_SIZE_MB > 0
+  if ((imgdata.progress_flags & LIBRAW_PROGRESS_OPEN) &&
+      !(imgdata.progress_flags & LIBRAW_PROGRESS_IDENTIFY))
+  {
+    const size_t limit =
+        size_t(LIBRAW_MAX_METADATA_ALLOC_SIZE_MB) * 1024U * 1024U;
+    size_t &used =
+        libraw_internal_data.internal_data.identify_allocated_bytes;
+    if (used > limit || t > limit - used)
+      throw LIBRAW_EXCEPTION_ALLOC;
+    used += t;
+  }
+#endif
   void *p = memmgr.malloc(t);
   if (!p)
     throw LIBRAW_EXCEPTION_ALLOC;
@@ -264,6 +277,19 @@
 }
 void *LibRaw::realloc(void *q, size_t t)
 {
+#if LIBRAW_MAX_METADATA_ALLOC_SIZE_MB > 0
+  if ((imgdata.progress_flags & LIBRAW_PROGRESS_OPEN) &&
+      !(imgdata.progress_flags & LIBRAW_PROGRESS_IDENTIFY))
+  {
+    const size_t limit =
+        size_t(LIBRAW_MAX_METADATA_ALLOC_SIZE_MB) * 1024U * 1024U;
+    size_t &used =
+        libraw_internal_data.internal_data.identify_allocated_bytes;
+    if (used > limit || t > limit - used)
+      throw LIBRAW_EXCEPTION_ALLOC;
+    used += t;
+  }
+#endif
   void *p = memmgr.realloc(q, t);
   if (!p)
     throw LIBRAW_EXCEPTION_ALLOC;
@@ -272,6 +298,22 @@
 
 void *LibRaw::calloc(size_t n, size_t t)
 {
+#if LIBRAW_MAX_METADATA_ALLOC_SIZE_MB > 0
+  if (t && n > size_t(-1) / t)
+    throw LIBRAW_EXCEPTION_ALLOC;
+  const size_t requested = n * t;
+  if ((imgdata.progress_flags & LIBRAW_PROGRESS_OPEN) &&
+      !(imgdata.progress_flags & LIBRAW_PROGRESS_IDENTIFY))
+  {
+    const size_t limit =
+        size_t(LIBRAW_MAX_METADATA_ALLOC_SIZE_MB) * 1024U * 1024U;
+    size_t &used =
+        libraw_internal_data.internal_data.identify_allocated_bytes;
+    if (used > limit || requested > limit - used)
+      throw LIBRAW_EXCEPTION_ALLOC;
+    used += requested;
+  }
+#endif
   void *p = memmgr.calloc(n, t);
   if (!p)
     throw LIBRAW_EXCEPTION_ALLOC;
