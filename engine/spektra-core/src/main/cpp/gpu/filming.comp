#version 450
// SPDX-FileCopyrightText: 2026 Spektrafilm Android contributors
// SPDX-License-Identifier: GPL-3.0-only
// Spektrafilm for Android - production FILMING pointwise kernel (#148).
// Promoted and modified from tools/gpu_probe/filming.comp after the #147 M2
// connected-device oracle/determinism gate. Modifications: production bindings,
// explicit non-finite containment, and resident-DAG documentation. No OFX shader
// source or binary resource is used here.
//
// fp32 port of the engine's pointwise chain (spatial/stochastic effects off):
//   filming::expose: ProPhoto RGB -> XYZ D55 -> tri2quad -> 4x4 Mitchell tc_lut
//                    -> log raw
//   filming::develop: density curves -> pointwise DIR couplers -> density curves
#define WG 64
layout(local_size_x = WG) in;

layout(std430, binding = 0) readonly  buffer InBuf    { float rgb[];       };
layout(std430, binding = 1) writeonly buffer OutBuf   { float dens[];      };
layout(std430, binding = 2) readonly  buffer TcLut    { float tc_lut[];    };
layout(std430, binding = 3) readonly  buffer DevAxis  { float dev_axis[];  };
layout(std430, binding = 4) readonly  buffer DevCurve { float dev_curve[]; };
layout(std430, binding = 5) readonly  buffer DirAxis  { float dir_axis[];  };
layout(std430, binding = 6) readonly  buffer DirCurve { float dir_curve[]; };
layout(push_constant) uniform Push {
    uint  npix;
    uint  groups_x;
    uint  total_groups;
    int   L;
    int   n;
    float exp_mult;
    float shift;
    float m[9];
} pc;

float finite_or(float v, float fallback) {
    return (isnan(v) || isinf(v)) ? fallback : v;
}

float mitchell(float t) {
    const float B = 1.0 / 3.0;
    const float C = 1.0 / 3.0;
    float x = abs(t);
    if (x < 1.0)
        return (1.0 / 6.0) * ((12.0 - 9.0 * B - 6.0 * C) * x * x * x +
                              (-18.0 + 12.0 * B + 6.0 * C) * x * x + (6.0 - 2.0 * B));
    if (x < 2.0)
        return (1.0 / 6.0) * ((-B - 6.0 * C) * x * x * x + (6.0 * B + 30.0 * C) * x * x +
                              (-12.0 * B - 48.0 * C) * x + (8.0 * B + 24.0 * C));
    return 0.0;
}

int safe_index(int idx, int L) {
    if (idx < 0) return -idx;
    if (idx >= L) return 2 * (L - 1) - idx;
    return idx;
}

float cubic_bf(float coord, int L, out int base) {
    if (coord <= 0.0) coord = 0.0;
    else if (coord >= float(L - 1)) coord = float(L - 1);
    if (coord >= float(L - 1)) { base = L - 2; return 1.0; }
    int b = int(floor(coord));
    base = clamp(b, 0, L - 2);
    return coord - float(base);
}

float log10f(float v) { return log2(v) * 0.30102999566398119521; }

float interp_dev(float x, int c) {
    int n = pc.n;
    float x0 = dev_axis[c], xN = dev_axis[(n - 1) * 3 + c];
    if (x <= x0) return dev_curve[c];
    if (x >= xN) return dev_curve[(n - 1) * 3 + c];
    int low = 0;
    int high = n - 1;
    while (high - low > 1) {
        int middle = low + (high - low) / 2;
        if (x < dev_axis[middle * 3 + c]) high = middle;
        else low = middle;
    }
    float xl = dev_axis[low * 3 + c], xh = dev_axis[high * 3 + c];
    float dx = xh - xl;
    float t = (dx != 0.0) ? (x - xl) / dx : 0.0;
    float y0 = dev_curve[low * 3 + c], y1 = dev_curve[high * 3 + c];
    return y0 + t * (y1 - y0);
}

float interp_dir(float x, int c) {
    int n = pc.n;
    float x0 = dir_axis[c], xN = dir_axis[(n - 1) * 3 + c];
    if (x <= x0) return dir_curve[c];
    if (x >= xN) return dir_curve[(n - 1) * 3 + c];
    int low = 0;
    int high = n - 1;
    while (high - low > 1) {
        int middle = low + (high - low) / 2;
        if (x < dir_axis[middle * 3 + c]) high = middle;
        else low = middle;
    }
    float xl = dir_axis[low * 3 + c], xh = dir_axis[high * 3 + c];
    float dx = xh - xl;
    float t = (dx != 0.0) ? (x - xl) / dx : 0.0;
    float y0 = dir_curve[low * 3 + c], y1 = dir_curve[high * 3 + c];
    return y0 + t * (y1 - y0);
}

void main() {
    uint group = gl_WorkGroupID.y * pc.groups_x + gl_WorkGroupID.x;
    if (group >= pc.total_groups) return;
    uint p = group * WG + gl_LocalInvocationID.x;
    if (p >= pc.npix) return;

    // Explicit containment is part of the production contract. Invalid source
    // components become black before any coordinate/index calculation.
    float r = finite_or(rgb[p * 3u + 0u], 0.0);
    float g = finite_or(rgb[p * 3u + 1u], 0.0);
    float bch = finite_or(rgb[p * 3u + 2u], 0.0);

    float X = 0.7815775876144749 * r + 0.12427353211547089 * g + 0.05084064074531416 * bch;
    float Y = 0.28106991658512925 * r + 0.7111246050020191 * g + 0.0078043503519031375 * bch;
    float Z = 0.0008785229438793953 * r + 0.0012166783269637077 * g + 0.9190442562432091 * bch;
    float bsum = X + Y + Z;
    float denom = max(bsum, 1e-10);
    float cx = clamp(X / denom, 0.0, 1.0);
    float cy = clamp(Y / denom, 0.0, 1.0);
    float qy = clamp(cy / max(1.0 - cx, 1e-10), 0.0, 1.0);
    float qx = clamp((1.0 - cx) * (1.0 - cx), 0.0, 1.0);
    float bmul = finite_or(bsum, 0.0);

    int L = pc.L;
    float scale = float(L - 1);
    int xb; float xf = cubic_bf(qx * scale, L, xb);
    int yb; float yf = cubic_bf(qy * scale, L, yb);
    float wx[4] = float[4](mitchell(xf + 1.0), mitchell(xf), mitchell(xf - 1.0), mitchell(xf - 2.0));
    float wy[4] = float[4](mitchell(yf + 1.0), mitchell(yf), mitchell(yf - 1.0), mitchell(yf - 2.0));
    float acc0 = 0.0, acc1 = 0.0, acc2 = 0.0, wsum = 0.0;
    for (int i = 0; i < 4; ++i) {
        int xi = safe_index(xb - 1 + i, L);
        for (int j = 0; j < 4; ++j) {
            int yj = safe_index(yb - 1 + j, L);
            float w = wx[i] * wy[j];
            wsum += w;
            int cell = (xi * L + yj) * 3;
            acc0 += w * tc_lut[cell + 0];
            acc1 += w * tc_lut[cell + 1];
            acc2 += w * tc_lut[cell + 2];
        }
    }
    if (wsum != 0.0) { acc0 /= wsum; acc1 /= wsum; acc2 /= wsum; }

    float lr0 = log10f(max(acc0 * bmul * pc.exp_mult, 0.0) + 1e-10);
    float lr1 = log10f(max(acc1 * bmul * pc.exp_mult, 0.0) + 1e-10);
    float lr2 = log10f(max(acc2 * bmul * pc.exp_mult, 0.0) + 1e-10);
    float d0 = interp_dev(lr0, 0);
    float d1 = interp_dev(lr1, 1);
    float d2 = interp_dev(lr2, 2);
    float s0 = d0 + pc.shift * d0 * d0;
    float s1 = d1 + pc.shift * d1 * d1;
    float s2 = d2 + pc.shift * d2 * d2;
    float o0 = interp_dir(lr0 - (s0 * pc.m[0] + s1 * pc.m[3] + s2 * pc.m[6]), 0);
    float o1 = interp_dir(lr1 - (s0 * pc.m[1] + s1 * pc.m[4] + s2 * pc.m[7]), 1);
    float o2 = interp_dir(lr2 - (s0 * pc.m[2] + s1 * pc.m[5] + s2 * pc.m[8]), 2);
    dens[p * 3u + 0u] = finite_or(o0, 1e4);
    dens[p * 3u + 1u] = finite_or(o1, 1e4);
    dens[p * 3u + 2u] = finite_or(o2, 1e4);
}
