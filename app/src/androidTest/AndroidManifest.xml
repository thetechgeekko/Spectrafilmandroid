<?xml version="1.0" encoding="utf-8"?>
<!-- Test-APK-only components for storage reliability instrumentation. GPLv3. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="com.spectrafilm.app.test.ticket170.READ_PROBE"
        android:protectionLevel="signature" />

    <application>
        <provider
            android:name="com.spectrafilm.app.Ticket170GrantProvider"
            android:authorities="com.spectrafilm.app.test.ticket170.grants"
            android:exported="true"
            android:grantUriPermissions="true">
            <!-- The control call remains reachable, but blob reads require the
                 explicit URI grant issued by the provider. -->
            <path-permission
                android:pathPrefix="/source/"
                android:readPermission="com.spectrafilm.app.test.ticket170.READ_PROBE" />
        </provider>

        <provider
            android:name="com.spectrafilm.app.Ticket139SourceProvider"
            android:authorities="com.spectrafilm.app.test.ticket139.sources"
            android:exported="true"
            android:grantUriPermissions="true">
            <path-permission
                android:pathPrefix="/source/"
                android:readPermission="com.spectrafilm.app.test.ticket170.READ_PROBE" />
        </provider>
    </application>
</manifest>
