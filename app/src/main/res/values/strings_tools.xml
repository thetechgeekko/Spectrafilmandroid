    <!-- Masks panel -->
    <string name="tool_masks_title">Masks</string>
    <string name="tool_masks_intro">Local adjustments: a mask limits the full adjustment set — exposure, temp/tint, saturation, hue, contrast, whites/blacks, and the detail controls — to one area. A radial targets a spot (brighten a face); a gradient ramps across the frame (darken a sky from the top). Composited on the final image — the film render is untouched.</string>
    <string name="tool_masks_add_radial">+ Radial mask</string>
    <string name="tool_masks_add_gradient">+ Gradient mask</string>
    <string name="tool_masks_tab">Mask %1$d</string>
    <string name="tool_masks_position_on_photo">Position on photo</string>
    <string name="tool_masks_temp">Temp</string>
    <string name="tool_masks_temp_help">White balance inside the mask: + warms (yellow), − cools (blue).</string>
    <string name="tool_masks_tint">Tint</string>
    <string name="tool_masks_tint_help">White balance inside the mask: + magenta, − green.</string>
    <string name="tool_masks_exposure">Exposure</string>
    <string name="tool_masks_exposure_help">Brighten / darken inside the mask, in stops (local dodge &amp; burn).</string>
    <string name="tool_masks_saturation">Saturation</string>
    <string name="tool_masks_saturation_help">Colorfulness inside the mask.</string>
    <string name="tool_masks_hue">Hue shift</string>
    <string name="tool_masks_hue_help">Rotate the hue of colors inside the mask, in degrees (e.g. shift a sky toward teal).</string>
    <string name="tool_masks_contrast">Contrast</string>
    <string name="tool_masks_contrast_help">Contrast inside the mask.</string>
    <string name="tool_masks_whites">Whites</string>
    <string name="tool_masks_whites_help">The brightest tones inside the mask: + brightens highlights, − recovers them.</string>
    <string name="tool_masks_blacks">Blacks</string>
    <string name="tool_masks_blacks_help">The darkest tones inside the mask: + lifts shadows, − deepens them.</string>
    <string name="tool_masks_clarity">Clarity</string>
    <string name="tool_masks_clarity_help">Midtone local contrast inside the mask (+ punch, − soften).</string>
    <string name="tool_masks_texture">Texture</string>
    <string name="tool_masks_texture_help">Fine detail inside the mask: + emphasizes, − smooths.</string>
    <string name="tool_masks_sharpness">Sharpness</string>
    <string name="tool_masks_sharpness_help">Edge sharpness inside the mask (unsharp mask on fine detail).</string>
    <string name="tool_masks_highlights">Highlights</string>
    <string name="tool_masks_highlights_help">Bright regions inside the mask: − recovers, + brightens.</string>
    <string name="tool_masks_shadows">Shadows</string>
    <string name="tool_masks_shadows_help">Dark regions inside the mask: + lifts, − deepens.</string>
    <string name="tool_masks_position_x">Position X</string>
    <string name="tool_masks_position_y">Position Y</string>
    <string name="tool_masks_size">Size</string>
    <string name="tool_masks_size_help">Radius of the mask (fraction of the frame).</string>
    <string name="tool_masks_feather">Feather</string>
    <string name="tool_masks_feather_help">Softness of the mask edge.</string>
    <string name="tool_masks_gradient_note">The effect ramps from 0 at the start point to full at the end point.</string>
    <string name="tool_masks_start_x">Start X</string>
    <string name="tool_masks_start_y">Start Y</string>
    <string name="tool_masks_end_x">End X</string>
    <string name="tool_masks_end_y">End Y</string>
    <string name="tool_masks_gradient_start_help">Where the gradient begins (no effect).</string>
