    <string name="tool_masks_invert">Invert (affect outside)</string>
    <string name="tool_masks_invert_help">Apply the adjustment OUTSIDE the mask instead of inside (e.g. darken all but the subject).</string>
    <string name="tool_masks_opacity">Mask opacity</string>
    <string name="tool_masks_limit_tones">Limit to tones</string>
    <string name="tool_masks_limit_tones_help">Restrict the adjustment to a brightness range — e.g. only the highlights, or only the shadows. Turn on, then use the eyedropper to pick the tone from your photo.</string>
