    <string name="editor_input_cctf_tooltip">Apply the inverse cctf transfer function of the color space</string>
    <string name="editor_input_creative_wb_heading">Creative white balance</string>
    <string name="editor_input_creative_wb_desc">A warm/cool + green/magenta grade on the image going into the film — works on every source (RAW, JPEG, HEIC). Separate from the RAW white balance; 0 = off.</string>
    <string name="editor_input_creative_warmth">Creative warmth</string>
    <string name="editor_input_creative_warmth_tooltip">Warm/cool the scene before the film sees it (Bradford adaptation in linear ProPhoto). Positive = warmer. 0 = no change.</string>
    <string name="editor_input_creative_tint">Creative tint</string>
    <string name="editor_input_creative_tint_tooltip">Green ↔ magenta shift. Positive = magenta, negative = green. 0 = no change.</string>
    <string name="editor_wb_eyedropper">Eyedropper — tap a neutral to set white balance</string>
    <string name="editor_input_gated_upsampling">MALLETT2019 isn\'t implemented yet — both options currently render as HANATOS2025.</string>
