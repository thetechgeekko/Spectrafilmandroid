    <!-- White balance section -->
    <string name="editor_wb_title">White balance</string>
    <string name="editor_wb_eyedropper_desc">Tap a grey or white area in your photo and the white balance is set to neutralize it. Works on every source — or use the sliders below.</string>
    <string name="editor_wb_warmth">Warmth</string>
    <string name="editor_wb_warmth_tooltip">Warm / cool the image. Positive = warmer; 0 = off. Works on every source.</string>
    <string name="editor_wb_tint">Tint</string>
    <string name="editor_wb_tint_tooltip">Green ↔ magenta. Positive = magenta, negative = green; 0 = off.</string>
    <string name="editor_wb_balance_to_stock">Balance to film stock</string>
    <string name="editor_wb_balance_tungsten">This is a tungsten-balanced stock, so it renders a daylight scene blue — that\'s authentic film behaviour. Turn this on to warm the input to the film\'s reference light and render neutral, like an 85 filter on the lens.</string>
    <string name="editor_wb_balance_daylight">The virtual 85 filter — warms the input to a tungsten stock\'s reference light so it renders neutral. This stock is daylight-balanced (already neutral), so it has no effect here.</string>
    <string name="editor_wb_raw_heading">RAW camera white balance (re-decodes the file):</string>
    <string name="editor_wb_camera">Camera white balance</string>
    <string name="editor_wb_reset_as_shot">Reset to camera / as-shot WB</string>
    <string name="editor_wb_custom_only">Temperature and Tint are used only when \"custom\" is selected above.</string>
    <string name="editor_wb_temperature">Temperature (K)</string>
    <string name="editor_wb_temperature_tooltip">Colour temperature in Kelvin for Custom white balance (1000 K – 12000 K).</string>
    <string name="editor_wb_tint_multiplier">Tint multiplier</string>
    <string name="editor_wb_tint_multiplier_tooltip">Green/magenta tint multiplier for Custom white balance (1.0 = neutral).</string>

